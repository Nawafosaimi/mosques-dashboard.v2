## Copy this file to ".env" and adjust as needed.

# Absolute or relative path to the folder containing the data files.
# Leave blank to use the repo's "mosques" directory by default.
MOSQUES_DATA_DIR=D:/energy/mosques

# Optional: where converted parquet caches should be stored.
# Defaults to "<MOSQUES_DATA_DIR>/cache" if unset.
MOSQUES_CACHE_DIR=D:/energy/mosques/cache

# Optional: Override the simplified regions GeoJSON location.
# Default: <MOSQUES_CACHE_DIR>/regions_simplified.geojson
MOSQUES_REGIONS_CACHE_FILE=

# Geometry simplification tolerance (0 disables simplification).
# Lower values keep more detail, higher values lighten the file.
REGIONS_SIMPLIFY_TOLERANCE=0.02

